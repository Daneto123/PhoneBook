# Копирайте като .env и попълнете.
# .env е в .gitignore: паролите никога не се качват в GitHub.

PORT=3000

# MongoDB, например безплатен клъстер в MongoDB Atlas:
#   mongodb+srv://ПОТРЕБИТЕЛ:ПАРОЛА@cluster0.xxxxx.mongodb.net/phonebook
# Празно = данните се пазят локално във файла data/contacts.json
DBCONNECTION=
